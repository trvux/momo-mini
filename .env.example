# Copy file này thành .env rồi đổi giá trị. .env không được commit.

# docker compose đọc 3 biến này để khởi tạo Postgres
POSTGRES_USER=admin-postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=momo-mini

# Go đọc biến này (qua godotenv). Phải khớp với 3 biến trên và cổng map ở docker-compose.yml
DATABASE_URL=postgres://admin-postgres:change-me@localhost:9000/momo-mini
